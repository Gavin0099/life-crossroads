  "assumptions": [
    {
      "id": "macro-friction",
      "version": "1",
      "statement": "需要數位資料的行動：網路使用率 >=90 時多用0格時間，60～<90多用1格，<60多用2格；電力取得率 <95 多用1格材料，否則0格。",
      "limitation": "這些門檻及成本是教學用情境指數。全國人口比例不是個人/家庭連線機率，也不能代表設備品質、教育、供電穩定度或個人因果。"
    },
    {
      "id": "household-scenarios",
      "version": "2",
      "statement": "兩個具穩定templateID的虛構家庭：互助共用模板初始健康66、財務35、人際65、技能20；獨用通勤模板初始健康64、財務60、人際50、技能20。所有國家沿用完全相同的模板數值，國名及排序不參與初始資源。",
      "limitation": "這些初始狀態是具名設計案例，不是家庭聯合分布、典型家庭或醫學因果；沒有真實發生頻率，不能用於國家排名。"
    },
    {
      "id": "learning-channels",
      "version": "1",
      "statement": "數位依賴逐選項明列。線上圖解、遠距課程使用數位情境規則；紙本創作、面對面練習與社區老師路線不讀取網路/電力比例，仍依交通、材料與協助計成本。",
      "limitation": "相同技能目標有不同途徑；數位人口比例不能限制本來不需要上網的活動。離線途徑的成本/效果也是設計假設。"
    },
    {
      "id": "life-stages",
      "version": "1",
      "statement": "0～12、13～22、23～40、41～60、61～100為五階段。每個關鍵事件重置時間/精力；跳躍時觸發到期故事。80歲回顧只為骨架收束。",
      "limitation": "年齡段、回合預算與收束年齡是遊戲節奏，不是人口或死亡模型；沒有將平均壽命當作死亡年齡。"
    },
    {
      "id": "agency",
      "version": "1",
      "statement": "童年學習由孩子表達意願並和可信任的大人共同安排；成人工作/照顧責任限23歲以上。家庭照顧安排只在23歲以上增加成本。",
      "limitation": "遊戲控制權規則，不是法律或對兒童責任的要求；不能把成人/社會限制歸責於孩子。"
    },
    {
      "id": "support-network",
      "version": "1",
      "statement": "情境支持0～2格：學習/求助/共同照顧可減少相同格數時間；學習有人陪伴增加人際2、技能1。",
      "limitation": "虛構可用支持，不代表某國人民較友善或每次求助都成功；沒有支持也保留免費休息路線。"
    },
    {
      "id": "choice-effects",
      "version": "1",
      "statement": "選項明列回合時間、精力、材料及四項資源變動；可行性不足不消耗資源、不產生後果。",
      "limitation": "資源與代價皆是設計單位，不是健康量表、貨幣或教育成就估計；沒有合成人生成功分數。"
    },
    {
      "id": "cost-fatigue",
      "version": "1",
      "statement": "學習準備佔去至少5格時間，健康暫減2格。",
      "limitation": "簡化遊戲取捨，不是醫學或勞動風險估計。"
    },
    {
      "id": "luck-encouragement",
      "version": "1",
      "statement": "可行的學習選項有25%額外鼓勵機會，人際+1。固定Seed+事件/年齡/機會通道的鍵控亂數，所有背景同一門檻。",
      "limitation": "完全為遊戲假設，沒有國家成功倍率；不同選項不消耗共用亂數序列。"
    },
    {
      "id": "resource-bounds",
      "version": "1",
      "statement": "四項長期資源各自限制0～100；成本最低0；clamp調整列入trace。",
      "limitation": "設計邊界，不是真實人生評價；人物價值不能由數值推導。"
    },
    {
      "id": "story-callback",
      "version": "1",
      "statement": "帶有後續標記的可行決策在4歲後由同一位虛構人物呼應，人際+2、技能+1；只觸發一次。",
      "limitation": "為LC-02保留人物牽掛的最小故事契約，並非證實現實長期因果；完整事件內容及試玩仍待後續切片。"
    }
  ],
